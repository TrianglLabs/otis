{
  "name": "@triangllabs/otis",
  "productName": "Otis",
  "desktopName": "ai.triangllabs.otis.desktop",
  "version": "0.2.15",
  "description": "Local terminal agent powered by tool-capable open models",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.cjs",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "dev:desktop": "electron-vite dev",
    "dev:demo": "OTIS_DEMO=1 electron-vite dev",
    "build": "bun run scripts/build.ts",
    "build:desktop": "electron-vite build",
    "build:desktop:icons": "bun run scripts/build-desktop-icons.ts",
    "build:desktop:tray": "bun run scripts/build-tray-icons.ts",
    "pack:desktop": "bun run build:desktop && electron-builder --dir",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check . && bash -n scripts/install.sh",
    "test": "bunx --bun vitest run",
    "test:integration": "OTIS_INTEGRATION=1 bunx --bun vitest run tests/integration",
    "test:documents": "python3 -m unittest discover -s tests/documents -p 'test_*.py'",
    "test:desktop:ui": "bun run scripts/test-desktop-ui.ts",
    "test:desktop:lifecycle": "bun run scripts/test-desktop-lifecycle.ts",
    "test:coverage": "vitest run --coverage --exclude='tests/cli/chat-ui-*.test.ts' && bunx --bun vitest run tests/cli/chat-ui-*.test.ts",
    "typecheck": "bun run scripts/typecheck.ts",
    "verify": "bun run check && bun run typecheck && bun run test",
    "build:desktop:demo": "electron-vite build --mode demo",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "terminal",
    "coding",
    "assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triangllabs/otis.git"
  },
  "homepage": "https://github.com/triangllabs/otis",
  "bugs": {
    "url": "https://github.com/triangllabs/otis/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@opentui/core": "^0.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/use-sync-external-store": "^1.7.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "diff": "^9.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.0",
    "jszip": "^3.10.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@mermaid-js/tiny": "12.0.0",
    "@xmldom/xmldom": "0.9.12",
    "border-beam": "^1.4.1",
    "electron-updater": "^6.8.9",
    "ghostty-web": "^0.4.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.42.0",
    "mammoth": "^1.12.3",
    "node-pty": "^1.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.13",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math-extended": "^6.1.1",
    "thinking-orbs": "^0.3.2",
    "use-sync-external-store": "^1.7.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  },
  "author": {
    "name": "Triangl Labs",
    "email": "nikita@triangllabs.ai"
  }
}
